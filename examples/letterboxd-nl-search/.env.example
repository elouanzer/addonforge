# Copy this file to .env and fill it in. Never commit .env.
# Docker Compose reads .env automatically. Restart after a change: docker compose up -d

# Port on this computer: http://127.0.0.1:<HOST_PORT>/manifest.json
HOST_PORT=7101

# Search backend: keyword (default, no key, offline), anthropic, openai or ollama.
# If the chosen backend is missing its key or model, the add-on logs why and uses keyword.
SEARCH_PROVIDER=keyword

# anthropic: an API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# openai: an API key, and a model your account can use. OPENAI_BASE_URL points at any
# OpenAI-compatible server (default https://api.openai.com/v1).
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ollama: a local model, free, nothing leaves your computer (https://ollama.com).
# Default URL works from Docker; without Docker use http://127.0.0.1:11434/v1
OLLAMA_URL=

# Model name. Defaults: claude-haiku-5-5 (anthropic), llama3.2 (ollama). Required for openai.
LLM_MODEL=

# Hide films you've already logged on Letterboxd (needs your export in data/).
HIDE_WATCHED=true

# Send your highest-rated Letterboxd films (titles and years only) to the LLM, to lean
# results towards your taste. Set to false to keep your ratings on this computer.
TASTE_HINTS=true

# Number of results per search (1 to 50).
MAX_RESULTS=20

# How long to wait for the LLM before falling back to keyword search, in milliseconds.
LLM_TIMEOUT_MS=20000
